+        repository=repository if repository is not None else Path.cwd(),
+        trusted_base=trusted_base or DEFAULT_TRUSTED_BASE,
+    )
+    if not result.ok:
+        print(f"[GUARD] governance authorization rejected: {result.reason}", file=sys.stderr)
+    return result.ok
 
 
