+def _port_is_free(host: str, port: int) -> bool:
+    """True when ``host:port`` can be bound right now (nobody is listening on it)."""
+    family = socket.AF_INET6 if ":" in host else socket.AF_INET
+    with socket.socket(family, socket.SOCK_STREAM) as probe:
+        if sys.platform != "win32":
+            # Like uvicorn: a TIME_WAIT leftover must not look like a live listener. Never on
+            # Windows, where SO_REUSEADDR would let the probe bind over a live listener.
+            probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+        try:
+            probe.bind((host, port))
+        except OSError:
+            return False
+    return True
+
+
+def _port_wait_timeout_sec() -> float:
+    """Seconds the restart helper waits for the old listener (``DARKFAC_WORKER_PORT_WAIT_SEC``, default 60)."""
+    raw = os.environ.get(ENV_WORKER_PORT_WAIT_SEC, "").strip()
+    try:
+        value = float(raw) if raw else DEFAULT_PORT_WAIT_SEC
+    except ValueError:
+        return DEFAULT_PORT_WAIT_SEC
+    return value if value > 0 else DEFAULT_PORT_WAIT_SEC
+
+
+def _poll_port_free(
+    host: str, port: int, timeout_sec: float, *, sleep: Any = time.sleep, clock: Any = time.monotonic
+) -> bool:
+    """Poll :func:`_port_is_free` with exponential backoff (0.25 s -> 2 s) for up to ``timeout_sec``."""
+    deadline = clock() + timeout_sec
+    delay = PORT_WAIT_INITIAL_DELAY_SEC
+    while True:
+        if _port_is_free(host, port):
+            return True
+        remaining = deadline - clock()
+        if remaining <= 0:
+            return False
+        sleep(min(delay, remaining))
+        delay = min(delay * 1.5, PORT_WAIT_MAX_DELAY_SEC)
+
+
