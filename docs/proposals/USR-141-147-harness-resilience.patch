+        monkeypatch.setenv("DARKFAC_SUITE_LOCK_REAP_STALLED", raw)
+        assert suite_lock._reap_stalled_enabled() is False
+    monkeypatch.setenv("DARKFAC_SUITE_LOCK_REAP_STALLED", "1")
