+    monkeypatch.setenv("DARKFAC_SUITE_LOCK_STALL_AFTER_SEC", "0")
+    monkeypatch.setenv("DARKFAC_SUITE_LOCK_STALL_WINDOW_SEC", "2.5")
+    assert suite_lock._stall_after_sec() == 0.0
+    assert suite_lock._stall_window_sec() == 2.5
