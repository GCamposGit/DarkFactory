    "darkfac": {
      "trigger": "Coordinator/Worker crash, migration failure, synthetic journey failure",
      "target_action": "docker compose down && docker compose -f deploy/dokploy/docker-compose.cloud.yml up -d with last_known_good_digest",
      "max_acceptable_downtime_seconds": 120,
      "data_loss_tolerance": "zero_rpo_for_control_store"
    },
    "site-ggcampos": {
      "trigger": "HTTP != 200, broken assets, SEO audit failure, layout collapse",
      "target_action": "atomic symlink or FTP overwrite to last_known_good_dist",
      "max_acceptable_downtime_seconds": 60,
      "data_loss_tolerance": "stateless_zero_data_loss"
    },
    "segundo-cerebro": {
      "trigger": "SQLite corruption, Chroma vector mismatch, MCP server crash",
      "target_action": "restore SQLite snapshot from .factory/backups/ and checkout last_known_good_sha",
      "max_acceptable_downtime_seconds": 60,
      "data_loss_tolerance": "zero_rpo_with_wal_replay"
    },
    "jarvis": {
      "trigger": "Port 8088 unresponsive, voice pipeline exception, budget overrun",
      "target_action": "kill PID and relaunch last_known_good_sha daemon",
      "max_acceptable_downtime_seconds": 30,
      "data_loss_tolerance": "stateless_daemon_zero_loss"
    }
  }
