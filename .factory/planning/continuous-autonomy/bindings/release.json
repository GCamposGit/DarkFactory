{
  "schema_version": "1.0",
  "ticket_id": "HF-12-01",
  "purpose": "Binding normativo de build real, captura de OCI/bytes digest, mapeamento de targets de deploy por projeto registrado, despacho com tracking de operação e salvaguardas de jornada sintética e rollback automatizado",
  "created_at": "2026-09-18T18:25:00Z",
  "baseline_sha": "83e5298eb231599076811802dceac8575c7f6feb",
  "depends_on": [
    "HF-26-03"
  ],
  "successors": [
    "HF-12-02",
    "HF-15-01",
    "HF-03-07"
  ],
  "environment_profile": "release-binding",
  "governing_rules": [
    "AGENTS.md",
    "CONTRACTS.md",
    "MISSION.md",
    "FACTORY_RULES.md"
  ],
  "release_protocol": {
    "name": "FiveStageAutonomousReleaseProtocol",
    "version": "1.0",
    "invariants": [
      "Zero deploy without confirmed OCI/bytes digest; synthetic/speculative deployments without confirmed digest are strictly rejected",
      "Webhook HTTP 200 without deterministic external_operation_id does not satisfy deployment binding",
      "Merge or deployment is not operational proof; release is only complete after deterministic synthetic journey succeeds",
      "Every secret reference must be strictly sanitized (provider, locator, variable_name) with zero plaintext tokens in storage or logs",
      "Scenario G8: Commercial paid projects enforce client acceptance before production; failure in production triggers automated rollback to last_known_good_digest without blocking independent projects"
    ],
    "stages": [
      {
        "stage_number": 1,
        "stage_id": "build_and_digest_capture",
        "name": "Build Real e Captura de Bytes/OCI Digest",
        "description": "Execução determinística do comando de build do alvo com cálculo e validação do digest imutável do artefato antes de qualquer avanço.",
        "preconditions": [
          "Preflight de worktree limpa e branch compatível verificado",
          "Manifesto de build e dependências resolvidos"
        ],
        "actions": [
          "Executa build command específico do target",
          "Captura digest OCI da imagem (ex: sha256:...) ou hash SHA-256 da árvore de bytes (dist/manifest)",
          "Rejeita imediatamente avanço se digest não for confirmado ou estiver divergente"
        ],
        "output_contract": "BuildArtifact(build_id, project_id, git_sha, artifact_digest, manifest_digest, image_tag, created_at)"
      },
      {
        "stage_number": 2,
        "stage_id": "deploy_dispatch_operation_id",
        "name": "Disparo de Deploy via DokployDeployClient / API com External Operation ID",
        "description": "Despacho da instrução de deploy ao provedor de infraestrutura (Dokploy PaaS / local runner) obtendo identificador rastreável da operação.",
        "preconditions": [
          "Digest confirmado na Etapa 1",
          "SecretReferences sanitizadas resolvidas apenas na fronteira de I/O"
        ],
        "actions": [
          "Invoca DokployDeployClient ou adapter local autenticado",
          "Captura external_operation_id único emitido pelo orquestrador/PaaS",
          "Grava registro ExternalOperation com status 'prepared' ou 'sent' no ControlStore"
        ],
        "output_contract": "ExternalOperation(operation_key, request_digest, provider, external_id, status='sent', observed_at)"
      },
      {
        "stage_number": 3,
        "stage_id": "deterministic_monitoring",
        "name": "Monitoramento de Operação até Término Determinístico",
        "description": "Polling com backoff exponencial limitado e timeout rígido até a operação atingir estado terminal 'succeeded' ou 'failed'.",
        "preconditions": [
          "external_operation_id válido registrado no ControlStore"
        ],
        "actions": [
          "Consulta status da operação no provedor pelo external_operation_id",
          "Enforça timeout de 15 minutos (release-binding)",
          "Rejeita respostas intermediárias ou Webhook 200 genérico sem status terminal comprovado",
          "Atualiza ExternalOperation para 'succeeded' ou 'failed'"
        ],
        "output_contract": "ExternalOperation(status='succeeded', observed_at) ou disparo de Rollback se 'failed'"
      },
      {
        "stage_number": 4,
        "stage_id": "synthetic_user_journey",
        "name": "Execução de Jornada Sintética do Usuário Final em Produção/Staging",
        "description": "Execução de testes operacionais de ponta a ponta (smoke journey) contra os endpoints públicos/locais para comprovar viabilidade em produção.",
        "preconditions": [
          "Etapa 3 terminada com status 'succeeded'",
          "DestinationPreflight aprovado (conectividade, portas, certificados)"
        ],
        "actions": [
          "Dispara testes funcionais de leitura e escrita (health, roundtrip de dados, autenticação, renderização de assets)",
          "Mede latência de resposta operacional",
          "Emite JourneySmokeTest evidenciando sucesso operacional"
        ],
        "output_contract": "JourneySmokeTest(test_id, target_environment, artifact_digest, scenarios_executed, passed=True, latency_ms)"
      },
      {
        "stage_number": 5,
        "stage_id": "automated_rollback",
        "name": "Protocolo de Rollback Automatizado",
        "description": "Reversão atômica e autônoma para last_known_good_digest em caso de falha no preflight, deploy ou jornada sintética.",
        "preconditions": [
          "Falha detectada na Etapa 3 (status 'failed' / timeout) ou Etapa 4 (JourneySmokeTest.passed == False)"
        ],
        "actions": [
          "Recupera last_known_good_digest registrado no release pipeline",
          "Executa comando de redeploy do digest estável anterior sem reconstrução",
          "Executa journey de verificação no alvo restaurado",
          "Registra RollbackReceipt no histórico de auditoria",
          "Mantém integridade dos logs e outbox; não afeta outros projetos em execução"
        ],
        "output_contract": "RollbackReceipt(rollback_id, project_id, failed_artifact_digest, restored_artifact_digest, trigger_reason, restored_at)"
      }
    ]
  },
