{
  "version": 2,
  "description": "USR-172/USR-343 S6: env ALLOWLIST for development-agent subprocesses (claude/codex/grok). Only keep_names, allow_names, allow_patterns and ticket capabilities reach the agent; everything else is dropped. deny_* still wins over allow_* (but not over keep_names/capabilities, except SOPS_/AGE_/GH_APP_ which always win).",
  "keep_names": [
    "ANTHROPIC_API_KEY",
    "CLAUDE_CODE_OAUTH_TOKEN",
    "OPENAI_API_KEY",
    "OPENROUTER_API_KEY",
    "XAI_API_KEY",
    "GROK_API_KEY",
    "GEMINI_API_KEY",
    "GOOGLE_API_KEY",
    "GROK_HOME",
    "CODEX_HOME",
    "CLAUDE_CONFIG_DIR",
    "ANTHROPIC_AUTH_TOKEN"
  ],
  "deny_names": [
    "GH_TOKEN",
    "GITHUB_TOKEN",
    "GH_ENTERPRISE_TOKEN",
    "GITHUB_ENTERPRISE_TOKEN",
    "DATABASE_URL"
  ],
  "deny_patterns": [
    "^DOKPLOY",
    "BACKUP",
    "^GH_ADMIN",
    "^GH_APP_",
    "^GITHUB_ADMIN",
    "^POSTGRES",
    "^PG(PASSWORD|USER|HOST)$",
    "^TELEGRAM",
    "^CLOUDFLARE",
    "^CF_API",
    "^AWS_",
    "^AZURE_",
    "^GCP_",
    "^DARKFAC_.*(TOKEN|SECRET|PASSWORD|KEY)",
    "(PASSWORD|PASSWD)$",
    "_SECRET(_KEY)?$",
    "SIGNING_KEY",
    "^SSH_AUTH_SOCK$",
    "^DEPLOY",
    "^SOPS_",
    "^AGE_",
    "TOKEN$|_TOKEN_|PRIVATE_KEY",
    "^DARKFAC_.*(TOKEN|KEY|SECRET|PASSWORD)"
  ],
  "network_allowlist": {
    "status": "infeasible_documented",
    "note": "USR-370: see docs/decisions/USR-370-network-allowlist.md (no real mechanism without admin rights). Hosts the agent legitimately reaches are documented here for a future sandbox.",
    "hosts": [
      "api.anthropic.com",
      "api.openai.com",
      "api.x.ai",
      "openrouter.ai",
      "github.com"
    ]
  },
  "allow_names": [
    "PATH",
    "PATHEXT",
    "SYSTEMROOT",
    "SYSTEMDRIVE",
    "WINDIR",
    "COMSPEC",
    "TEMP",
    "TMP",
    "TMPDIR",
    "HOME",
    "HOMEDRIVE",
    "HOMEPATH",
    "USERPROFILE",
    "APPDATA",
    "LOCALAPPDATA",
    "PROGRAMDATA",
    "PUBLIC",
    "ALLUSERSPROFILE",
    "USERNAME",
    "USER",
    "LOGNAME",
    "USERDOMAIN",
    "COMPUTERNAME",
    "NUMBER_OF_PROCESSORS",
    "OS",
    "LANG",
    "LANGUAGE",
    "TERM",
    "COLORTERM",
    "SHELL",
    "VIRTUAL_ENV",
    "NODE_OPTIONS",
    "NODE_PATH",
    "NODE_EXTRA_CA_CERTS",
    "NPM_CONFIG_PREFIX",
    "NO_COLOR",
    "FORCE_COLOR",
    "CI",
    "EDITOR",
    "PWD",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR",
    "REQUESTS_CA_BUNDLE",
    "CURL_CA_BUNDLE",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "ALL_PROXY",
    "XDG_CONFIG_HOME",
    "XDG_DATA_HOME",
    "XDG_CACHE_HOME",
    "XDG_RUNTIME_DIR",
    "GIT_EXEC_PATH",
    "GIT_TERMINAL_PROMPT",
    "GIT_CONFIG_GLOBAL",
    "GIT_CONFIG_NOSYSTEM",
    "MSYSTEM",
    "EXEPATH",
    "PSMODULEPATH",
    "LOGONSERVER",
    "USERDOMAIN_ROAMINGPROFILE",
    "API_TIMEOUT_MS",
    "NODE_USE_SYSTEM_CA",
    "DISABLE_AUTOUPDATER",
    "DISABLE_MICROCOMPACT",
    "COREPACK_ENABLE_AUTO_PIN",
    "SHLVL",
    "_",
    "__COMPAT_LAYER",
    "CLAUDECODE",
    "AI_AGENT",
    "PLINK_PROTOCOL",
    "DRIVERDATA"
  ],
  "allow_patterns": [
    "^PROGRAMFILES",
    "^PROGRAMW6432$",
    "^COMMONPROGRAMFILES",
    "^PROCESSOR_",
    "^LC_",
    "^PYTHON(?!STARTUP$)",
    "^npm_config_",
    "^(CLAUDE|CLAUDECODE|ANTHROPIC|CODEX|GROK|OPENAI|OPENROUTER|XAI|GEMINI)_",
    "^GOOGLE_(GENAI|CLOUD_PROJECT|API)",
    "^DARKFAC_",
    "^FAKE_",
    "^GIT_",
    "^CUDA_",
    "^COMMONPROGRAM",
    "^ONEDRIVE",
    "^MCP_"
  ]
}
