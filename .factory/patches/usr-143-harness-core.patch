+def test_stalled_holder_with_zero_cpu_is_released(tmp_path: Path) -> None:
+    """Process A holds the lock but is stalled (sleeping / 0 CPU).
+
+    Process B with low stall_sec threshold must detect the stall, terminate
+    process A, and successfully acquire the lock (USR-143).
+    """
+    state_dir = tmp_path / "stalled_state"
+    marker_a = tmp_path / "a_acquired.txt"
+
+    # Start process A which acquires lock and sleeps for 60s without CPU usage
+    proc_a = subprocess.Popen(
+        [sys.executable, "-c", _contender_script(state_dir, marker_a, 60.0)],
+    )
+    try:
+        deadline = time.monotonic() + 10
+        while not marker_a.exists() and time.monotonic() < deadline:
+            time.sleep(0.05)
+        assert marker_a.exists(), "process A never acquired the lock"
+
+        # Now contender B attempts to acquire with stall_sec=0.5
+        b_lock = suite_lock.SuiteLock(timeout_sec=5.0, stall_sec=0.5)
+        os.environ["DARKFAC_HARNESS_STATE_DIR"] = str(state_dir)
+        b_lock.acquire()
+        try:
+            assert b_lock.held is True
+            # Process A should have been terminated by B's stall detector
+            time.sleep(0.5)
+            assert proc_a.poll() is not None, "process A should have been terminated due to zero CPU stall"
+        finally:
+            b_lock.release()
+    finally:
+        if proc_a.poll() is None:
+            proc_a.kill()
+
