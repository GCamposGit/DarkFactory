+def _check_and_release_stalled_holder(
+    lock_path: Path,
+    tracker: dict[int, tuple[float, float]],
+    stall_sec: float,
+) -> bool:
+    """Check if the process holding ``lock_path`` is dead or stalled (0 CPU).
+
+    Returns True if a stalled/dead holder was cleaned up, meaning the slot
+    might now be free for acquisition.
+    """
+    info = _read_sidecar(lock_path)
+    if not info:
+        return False
+
+    pid = info.get("pid")
+    if not isinstance(pid, int) or pid <= 0:
+        return False
+
+    hostname = str(info.get("hostname") or "").lower()
+    my_hostname = socket.gethostname().lower()
+    if hostname and hostname != my_hostname:
+        return False
+
+    if pid == os.getpid():
+        return False
+
+    try:
+        import psutil
+    except ImportError:
+        return False
+
+    now = time.monotonic()
+
+    # Case 1: Process does not exist in the OS process table
+    if not psutil.pid_exists(pid):
+        with contextlib.suppress(OSError):
+            _sidecar_path(lock_path).unlink()
+        tracker.pop(pid, None)
+        return True
+
+    try:
+        proc = psutil.Process(pid)
+        if not proc.is_running() or proc.status() in (psutil.STATUS_ZOMBIE, psutil.STATUS_DEAD):
+            with contextlib.suppress(OSError):
+                _sidecar_path(lock_path).unlink()
+            tracker.pop(pid, None)
+            return True
+
+        # Case 2: Inspect CPU activity ("CPU parada")
+        cpu_times = proc.cpu_times()
+        total_cpu = cpu_times.user + cpu_times.system
+
+        if pid not in tracker:
+            tracker[pid] = (total_cpu, now)
+            return False
+
+        prev_cpu, first_stopped = tracker[pid]
+        if total_cpu > prev_cpu + 0.05:
+            # CPU is advancing (active test work underway)
+            tracker[pid] = (total_cpu, now)
+            return False
+
+        # CPU has NOT advanced
+        stopped_duration = now - first_stopped
+        if stopped_duration >= stall_sec:
+            print(
+                f"[SUITE_LOCK] holder pid {pid} stalled (0.0s CPU for {stopped_duration:.1f}s >= "
+                f"{stall_sec:.1f}s threshold); releasing stalled holder and reclaiming slot"
+            )
+            with contextlib.suppress(Exception):
+                for child in proc.children(recursive=True):
+                    with contextlib.suppress(Exception):
+                        child.kill()
+                proc.kill()
+                proc.wait(timeout=3.0)
+
+            with contextlib.suppress(OSError):
+                _sidecar_path(lock_path).unlink()
+            tracker.pop(pid, None)
+            return True
+
+    except (psutil.NoSuchProcess, psutil.AccessDenied):
+        pass
+
+    return False
+
+
