XAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=

# Required only to enable POST /api/usage/models/events
DARKFAC_TELEMETRY_KEY=

# Optional quota snapshots: JSON text or path to a JSON file
