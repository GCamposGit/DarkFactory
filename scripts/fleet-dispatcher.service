[Unit]
Description=DarkFac fleet dispatcher
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=darkfac
Group=darkfac
WorkingDirectory=/opt/darkfac
EnvironmentFile=-/etc/darkfac/fleet-dispatcher.env
Environment=DARKFAC_OPERATING_HARNESS=
Environment=PROJECT_ROOT=/opt/darkfac
Environment=STATE_ROOT=/opt/darkfac/.factory
ExecStart=/opt/darkfac/.venv/bin/python -m core.line.fleet_bootstrap --project-root /opt/darkfac --state-root /opt/darkfac/.factory --loop
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
LogsDirectory=darkfac
LogsDirectoryMode=0750

[Install]
WantedBy=multi-user.target
