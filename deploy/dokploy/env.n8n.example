# ==============================================================================
# n8n Community Self-Hosted Configuration - Dokploy Environment Template
# Copy this file to .env or paste into the Dokploy Environment Variables UI
# Governed by HYBRID_WORKFLOW_PLAN_2026-09-08 (Section 10)
# ==============================================================================

# Public Hostname & Webhook Base URL
N8N_HOST=n8n.ggcampos.com
N8N_WEBHOOK_URL=https://n8n.ggcampos.com/

# Database Credentials (Dedicated PostgreSQL 16 on dokploy-network)
N8N_DB_USER=n8n
N8N_DB_PASSWORD=strong_random_db_password_here
N8N_DB_NAME=n8n

# n8n Secret Encryption Key (CRITICAL: Must remain constant across restarts to decrypt credentials)
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=strong_random_encryption_key_32_bytes_hex

# Agent API Key (Obtain from n8n UI -> Settings -> n8n API -> Create API Key)
# Configure this in DarkFac local/cloud environment as N8N_API_KEY
N8N_API_KEY=your_n8n_api_key_here
