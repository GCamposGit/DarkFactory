# ==============================================================================
# DarkHub 24/7 Cloud Configuration - Dokploy Environment Template
# Copy this file to .env or paste into the Dokploy Environment Variables UI
# ==============================================================================

# Application Port
PORT=8000

# Allowed Hostnames and IPs (anti-DNS rebinding and containment - DF-08)
DARKHUB_ALLOWED_HOSTS=localhost,127.0.0.1,darkhub.ggcampos.com,dokploy.ggcampos.com,178.105.73.168,100.83.176.60

# GitHub Personal Access Token (for cloning private repo during compose build)
GITHUB_PAT=ghp_your_github_personal_access_token_here

# GitHub Webhook HMAC Secret (Matches the secret configured in GitHub repo webhook settings)
GITHUB_WEBHOOK_SECRET=darkfac_gh_webhook_secret_change_me

# Dokploy Continuous Deployment Webhook URL (INFRA-09)
DOKPLOY_DEPLOY_URL=https://dokploy.ggcampos.com/api/deploy/compose/khkMuDfjN_0OtOGWTBet2

# Cloudflare Zero Trust Access Integration (optional edge header authentication)
CLOUDFLARE_ZERO_TRUST_ENABLED=false
CLOUDFLARE_ZERO_TRUST_AUD=

# Externally hosted demo/services. The cloud Hub does not spawn local processes.
DARKHUB_ENABLE_LOCAL_SERVICE_LAUNCH=false
# JSON object keyed by catalog service id, for example:
# DARKHUB_SERVICE_URL_OVERRIDES={"canaletto-gallery":"https://demo.example.com"}
DARKHUB_SERVICE_URL_OVERRIDES=

# Telemetry and Usage Synchronization Secret (USR-01)
# Shared secret protecting POST /api/usage/sync and POST /api/usage/models/events
DARKFAC_TELEMETRY_KEY=change_me_to_a_secure_shared_secret

# Canonical workflow control store read by the task board (USR-42)
# Same PostgreSQL used by darkfac-coordinator/worker (DARKFAC_HF02_DATABASE_URL).
# Prefer a read-only role: the Hub only runs SELECT on runs/jobs.
# Format: postgresql://<readonly_user>:<password>@<host>:5432/<database>
DARKHUB_CONTROL_DATABASE_URL=

# Local Tailscale cluster URL for Ollama GPU inference (predator-neo-16 / workstation)
OLLAMA_BASE_URL=http://100.81.84.124:11434

# Persistence storage paths
DATA_DIR=/app/hub/data
FACTORY_DIR=/app/.factory

# Telegram Gateway Integration (HF-14 / DH-17)
# Bot token from @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=
# Comma-separated allowed Telegram user IDs (e.g. 12345678,87654321)
TELEGRAM_AUTHORIZED_USERS=
# Comma-separated allowed Telegram chat IDs
TELEGRAM_AUTHORIZED_CHATS=
# Secret token for validating Telegram webhook callbacks
TELEGRAM_WEBHOOK_SECRET=

# n8n Community Self-Hosted Integration (HF-14 / DH-17)
# Operational instance URL (default: https://n8n.ggcampos.com)
N8N_URL=https://n8n.ggcampos.com
# API Key generated in n8n UI -> Settings -> API -> Create API Key
N8N_API_KEY=
# Optional custom webhook trigger URL for n8n
N8N_WEBHOOK_URL=

# Remote Test Workers over Tailscale (HF-27-09)
REMOTE_HARNESS_URLS=http://100.78.181.90:8080,http://100.81.84.124:8080
