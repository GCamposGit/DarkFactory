# syntax=docker/dockerfile:1
# Dark Factory Cloud Coordinator & Worker Dockerfile (Dokploy PaaS / Hetzner VPS)
# Ticket: HF-03-01 | ADR-HF-001 / INFRA-05 / INFRA-06 / INFRA-07
# HF-27-09 adds the agent-CLI toolchain (git, gh, Node, Claude Code, Codex,
# lftp) so the same image can run a `core.orchestrator.cloud_worker` with
# `harness:claude` / `harness:codex` capabilities on the VPS.

FROM python:3.12-slim AS base

# Pinned versions (HF-27-09). Bump deliberately; see
# docs/runbooks/HF-27-09_topology.md for how to check for/apply updates.
ARG NODE_MAJOR=20
ARG GH_CLI_VERSION=2.101.0
ARG CLAUDE_CODE_VERSION=2.0.1
ARG CODEX_CLI_VERSION=0.48.0

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    DARKFAC_ENV=production \
    HOME=/home/darkfac

WORKDIR /app

# Install minimal OS utilities for health probes/process inspection, plus
# git (workspace checkouts), lftp (FTP-target deploys), tar (gh tarball) and gnupg (NodeSource key).
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    tar \
    procps \
    git \
    lftp \
    && rm -rf /var/lib/apt/lists/*

# Install GitHub CLI (gh) from the pinned GitHub release tarball, verified
# against the release checksums file. (The cli.github.com apt repo only keeps
# the latest version, so a pinned apt install breaks as soon as it is bumped.)
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    base="https://github.com/cli/cli/releases/download/v${GH_CLI_VERSION}"; \
    tmp="$(mktemp -d)"; \
    curl -fsSL "${base}/gh_${GH_CLI_VERSION}_linux_${arch}.tar.gz" -o "${tmp}/gh.tar.gz"; \
    curl -fsSL "${base}/gh_${GH_CLI_VERSION}_checksums.txt" -o "${tmp}/checksums.txt"; \
    expected="$(grep " gh_${GH_CLI_VERSION}_linux_${arch}.tar.gz\$" "${tmp}/checksums.txt" | cut -d' ' -f1)"; \
    test -n "${expected}"; \
    echo "${expected}  ${tmp}/gh.tar.gz" | sha256sum -c -; \
    tar -xzf "${tmp}/gh.tar.gz" -C "${tmp}" --strip-components=1 "gh_${GH_CLI_VERSION}_linux_${arch}/bin/gh"; \
    install -m 755 "${tmp}/bin/gh" /usr/local/bin/gh; \
    rm -rf "${tmp}"; \
    gh --version

# Install Node.js LTS from NodeSource (major version pinned via build arg).
RUN curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install pinned agent CLIs globally via npm: Claude Code and Codex.
RUN npm install -g \
    "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    "@openai/codex@${CODEX_CLI_VERSION}" \
    && npm cache clean --force

# Install core requirements and pinned durable execution libraries
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir "dbos==2.31.1" "psycopg[binary]>=3.2.0,<3.3.0" "psutil>=6.0.0"

# Create non-root system user for security
RUN groupadd -g 1000 darkfac && \
    useradd -u 1000 -g darkfac -m -s /bin/bash darkfac

# Copy application files and factory metadata
COPY core /app/core
COPY hub /app/hub
COPY docs /app/docs
COPY scripts /app/scripts
COPY deploy /app/deploy
COPY spikes /app/spikes
COPY .factory /app/.factory
COPY harness.config.json /app/harness.config.json

# Create artifact/log directories plus the CLI auth and workspace volumes
# (HF-27-09): /home/darkfac/.codex holds Codex's auth.json across restarts,
# /workspaces holds the per-run Git worktrees (core.line.workspace).
RUN mkdir -p /app/.factory/artifacts /app/.factory/test_logs /app/data \
             /home/darkfac/.codex /workspaces && \
    chown -R darkfac:darkfac /app /home/darkfac /workspaces

VOLUME ["/home/darkfac/.codex", "/workspaces"]

USER darkfac

# CLAUDE_CODE_OAUTH_TOKEN is injected at runtime via the Dokploy service's
# Environment tab (a secret, never baked into the image); see
# docs/runbooks/HF-27-09_topology.md for the exact screen and field name.

# Default entrypoint delegating to specified command in docker-compose
CMD ["python", "-m", "core.orchestrator.cloud_coordinator"]
