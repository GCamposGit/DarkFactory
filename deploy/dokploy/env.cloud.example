# ==============================================================================
# Dark Factory Cloud Coordinator & Worker - Dokploy Environment Template
# Copy this file to .env or paste into the Dokploy Environment Variables UI
# Ticket: HF-03-01 / ADR-HF-001
# ==============================================================================

# Database Connection (PostgreSQL on VPS Dokploy)
# Use internal Dokploy network hostname or Tailscale mesh IP
# Format: postgresql://<user>:<password>@<host>:5432/<database>
DARKFAC_HF02_DATABASE_URL=

# Concurrency Slots (Initial limit of 2 for 4 GB RAM VPS; scalable on future upgrade)
DARKFAC_MAX_CONCURRENT_SLOTS=2

# Coordinator internal port
DARKFAC_COORDINATOR_PORT=8001

# Worker Identity
DARKFAC_WORKER_ID=cloud-worker-1

# ------------------------------------------------------------------------------
# HF-27-09: VPS + on-prem worker topology (see docs/runbooks/HF-27-09_topology.md)
# ------------------------------------------------------------------------------

# Capabilities this worker publishes to the claim() queue, as `role` and
# `harness:<name>` tags matched against each job's required_capabilities.
# The VPS publishes the deterministic roles plus the two subscription
# harnesses that support headless CLI login (Claude Code, Codex). A
# harness:x whose auth probe fails at boot (see core/line/auth_bootstrap.py)
# is dropped automatically, so it is safe to list both here even before
# login is completed.
DARKFAC_WORKER_CAPS=git,gh,node,python,harness:claude,harness:codex

# Priority in the VPS > Desktop > Notebook topology. Controls both the poll
# interval (primary=2s, secondary=10s, fallback=20s) and the ready_age
# filter (primary claims immediately; secondary/fallback only claim jobs
# older than 30s, giving the VPS first refusal). Valid values: primary,
# secondary, fallback. Leave unset to keep the pre-HF-27-09 behaviour
# (5s poll, no ready_age filter).
DARKFAC_WORKER_PRIORITY=primary

# Quota knowledge in the worker container. Claude: headroom is probed live with CLAUDE_CODE_OAUTH_TOKEN.
# Codex: read from the rate limits Codex logs in /home/darkfac/.codex/sessions after each call (data older
# than 1h counts as unknown). A subscription harness with UNKNOWN quota (Codex before its first call) is
# fail-closed unless this is `last_resort`: then it is elected only after every known-healthy harness and
# before OpenRouter. A harness known to be at <=15% stays excluded either way. The compose file sets it on
# the worker service only; remove the line (or set empty) to restore strict fail-closed.
DARKFAC_ROUTING_UNKNOWN_QUOTA=last_resort

# Root directory for per-run Git worktrees (core.line.workspace). Must match
# the Dockerfile's /workspaces volume mount.
DARKFAC_WORKSPACES=/workspaces

# Claude Code subscription token for the VPS. Generate with `claude
# setup-token` on a machine with a browser (Desktop) and paste the resulting
# token here / into the Dokploy service's Environment tab. Never commit a
# real value. See docs/runbooks/HF-27-09_topology.md for the exact screen.
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub Token for private repository access (optional in runtime if cloned)
GITHUB_PAT=

# AI Provider API Keys (injected via secret manager or env)
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Ollama inference endpoint (if accessing local machine or VPS Ollama)
OLLAMA_BASE_URL=http://100.81.84.124:11434

# Dokploy Continuous Deployment Webhook URL (INFRA-09 / HF-07-02)
DOKPLOY_DEPLOY_URL=https://dokploy.ggcampos.com/api/deploy/compose/W2IBCGpn2gwVyxPWEcmH8

# ------------------------------------------------------------------------------
# INFRA-08: Cloudflare R2 & On-Premise 3-Tier Backups
# ------------------------------------------------------------------------------
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=darkfac-backups
DARKFAC_BACKUP_ENCRYPTION_KEY=
DARKFAC_ONPREM_BACKUP_DIR=E:\DarkFac\Backups

# Remote Headless AI Harness URLs (Desktop primary -> Notebook fallback)
REMOTE_HARNESS_URLS=http://100.78.181.90:8080,http://100.81.84.124:8080

# Internal paths
DATA_DIR=/app/data
FACTORY_DIR=/app/.factory

# ------------------------------------------------------------------------------
# Owner notifications (core.notifications.service.NotificationService,
# role="owner") -- used by darkfac-worker (core.line.human, grill/human-in-
# the-loop blocks) and by darkfac-canary (failure + weekly-summary alerts).
# Create a bot with @BotFather, then message it once from each Telegram
# account/group that should receive alerts and read its numeric chat id
# from https://api.telegram.org/bot<token>/getUpdates.
# ------------------------------------------------------------------------------

# Bot token from @BotFather, e.g. 123456789:AAExampleTokenDoNotCommitRealValue
TELEGRAM_OWNER_BOT_TOKEN=

# Comma-separated numeric Telegram user ids allowed to interact with the bot
TELEGRAM_AUTHORIZED_USERS=

# Comma-separated numeric Telegram chat ids (users or groups) that receive alerts
TELEGRAM_AUTHORIZED_CHATS=

# ------------------------------------------------------------------------------
# HF-27-10: daily E2E canary (see docs/runbooks/canary.md). Leave
# DARKFAC_CANARY_BASE_URL empty until the darkfac-canary repo + Dokploy app
# exist; the darkfac-canary service is also gated behind the `canary`
# compose profile, so it is a no-op either way until both are set up.
# ------------------------------------------------------------------------------

# Base URL of the deployed darkfac-canary app, e.g. https://canary.ggcampos.com
DARKFAC_CANARY_BASE_URL=

# Where the canary writes/reads its daily JSON reports (green-streak state).
# Matches the darkfac-canary-reports-v2 volume mount in docker-compose.cloud.yml
# -- change both together if you change this.
DARKFAC_CANARY_REPORTS_DIR=/app/.factory/reports/canary

# Set to "true" once you want the factory to start dogfooding its own
# roadmap (only takes effect after a real 7-day green streak). Leave "false"
# until you have reviewed docs/runbooks/canary.md section 5.
DARKFAC_DOGFOOD_ENABLED=false


# Green canary days required before dogfood submits (code default 7; the
# compose defaults it to 1 so the line starts as soon as one day is green).
DARKFAC_DOGFOOD_MIN_STREAK=1

# Same-day canary attempts after a terminal failure (attempt 2 = canary:<date>:a2 ...).
DARKFAC_CANARY_MAX_ATTEMPTS_PER_DAY=4

# ------------------------------------------------------------------------------
# darkfac-pg-tailnet: TCP forwarder exposing the Postgres service on the VPS
# Tailscale IP only (docs/runbooks/HF-27-09_topology.md section 2).
# ------------------------------------------------------------------------------
DARKFAC_TAILNET_BIND_IP=100.83.176.60
DARKFAC_PG_UPSTREAM=darkfaccore-postgresprimary-aebh67:5432

# Codex sandbox inside the worker container: bypass (default in the compose) | danger-full-access | auto.
# The container is the isolation boundary; Codex's Linux landlock sandbox cannot start in it.
DARKFAC_CODEX_SANDBOX_MODE=bypass

# Max sends of the same ticket through /linha after its run ended without delivering (default 5).
DARKFAC_LINE_MAX_TICKET_ATTEMPTS=10
