{
  "steps": [
    {
      "name": "syntax_and_types",
      "cmd": "python -m compileall -q core hub run_hub.py",
      "quick": true,
      "kind": "check"
    },

    {
      "name": "unit_and_integration_tests_parallel",
      "cmd": "python -m pytest tests -q -n auto --dist worksteal -m \"not serial\" --durations=25 --ignore=tests/test_canaletto.py",
      "quick": true,
      "kind": "test",
      "timeout_sec": 900
    },

    {
      "name": "unit_and_integration_tests_serial",
      "cmd": "python -m pytest tests -q -m serial --ignore=tests/test_canaletto.py",
      "quick": true,
      "kind": "test",
      "timeout_sec": 300
    }
  ]
}
